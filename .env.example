OPENAI_API_KEY=your_openai_api_key_here

# Model selection
OPENAI_MODEL=gpt-realtime

# Voice selection (available voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse)
OPENAI_VOICE=alloy

# Frame capture intervals (in milliseconds)
# Idle mode: when user is not speaking (default: 6000ms = 1 frame every 6 seconds)
IDLE_FRAME_INTERVAL_MS=10000
SPEAK_FRAME_INTERVAL_MS=1000

# Server-side VAD settings (for OpenAI Realtime API)
# Threshold for speech detection (0.0 to 1.0, default: 0.5)
OPENAI_SERVER_SIDE_VAD_THRESHOLD=0.5
# Padding before speech starts (in milliseconds, default: 500)
OPENAI_SERVER_SIDE_VAD_PREFIX_PADDING_MS=500
# Silence duration before turn ends (in milliseconds, default: 500)
OPENAI_SERVER_SIDE_VAD_SILENCE_DURATION_MS=500
